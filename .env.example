# Copy to .env (gitignored) and fill in. tools/assets.* and tools/check-key.* load it.
# Or set the variable in your shell or a secrets manager (Doppler, 1Password CLI, ...) instead.
#
# Open Cloud API key with "assets" read and write for the creator in asphalt.toml.
# Prefer a key owned by a separate uploader account (see docs/workflows.md).
ASPHALT_API_KEY=
